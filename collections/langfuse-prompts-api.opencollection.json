{
  "opencollection": "1.0.0",
  "info": {
    "name": "langfuse AnnotationQueues Prompts API",
    "version": "1.0"
  },
  "items": [
    {
      "info": {
        "name": "Prompts",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "prompts_get",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/api/public/v2/prompts/:promptName",
            "params": [
              {
                "name": "promptName",
                "value": "",
                "type": "path",
                "description": "The name of the prompt. If the prompt is in a folder (e.g., \"folder/subfolder/prompt-name\"), \nthe folder path must be URL encoded."
              },
              {
                "name": "version",
                "value": "",
                "type": "query",
                "description": "Version of the prompt to be retrieved."
              },
              {
                "name": "label",
                "value": "",
                "type": "query",
                "description": "Label of the prompt to be retrieved. Defaults to \"production\" if no label or version is set."
              },
              {
                "name": "resolve",
                "value": "",
                "type": "query",
                "description": "Resolve prompt dependencies before returning the prompt. Defaults to `true`. Set to `false` to return the raw stored prompt with dependency tags intact. This bypasses prompt caching and is intended for debugging or one-off jobs, not production runtime fetches."
              }
            ],
            "auth": {
              "type": "basic",
              "username": "{{username}}",
              "password": "{{password}}"
            }
          },
          "docs": "Get a prompt"
        },
        {
          "info": {
            "name": "prompts_delete",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/public/v2/prompts/:promptName",
            "params": [
              {
                "name": "promptName",
                "value": "",
                "type": "path",
                "description": "The name of the prompt"
              },
              {
                "name": "label",
                "value": "",
                "type": "query",
                "description": "Optional label to filter deletion. If specified, deletes all prompt versions that have this label."
              },
              {
                "name": "version",
                "value": "",
                "type": "query",
                "description": "Optional version to filter deletion. If specified, deletes only this specific version of the prompt."
              }
            ],
            "auth": {
              "type": "basic",
              "username": "{{username}}",
              "password": "{{password}}"
            }
          },
          "docs": "Delete prompt versions. If neither version nor label is specified, all versions of the prompt are deleted."
        },
        {
          "info": {
            "name": "prompts_list",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/api/public/v2/prompts",
            "params": [
              {
                "name": "name",
                "value": "",
                "type": "query"
              },
              {
                "name": "label",
                "value": "",
                "type": "query"
              },
              {
                "name": "tag",
                "value": "",
                "type": "query"
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "page number, starts at 1"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "limit of items per page"
              },
              {
                "name": "fromUpdatedAt",
                "value": "",
                "type": "query",
                "description": "Optional filter to only include prompt versions created/updated on or after a certain datetime (ISO 8601)"
              },
              {
                "name": "toUpdatedAt",
                "value": "",
                "type": "query",
                "description": "Optional filter to only include prompt versions created/updated before a certain datetime (ISO 8601)"
              }
            ],
            "auth": {
              "type": "basic",
              "username": "{{username}}",
              "password": "{{password}}"
            }
          },
          "docs": "Get a list of prompt names with versions and labels"
        },
        {
          "info": {
            "name": "prompts_create",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/api/public/v2/prompts",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "basic",
              "username": "{{username}}",
              "password": "{{password}}"
            }
          },
          "docs": "Create a new version for the prompt with the given `name`"
        }
      ]
    }
  ],
  "bundled": true
}