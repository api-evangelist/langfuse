            "name": "legacy observations V1 get Many",
            "description": {
              "content": "Get a list of observations.\n\nConsider using the [v2 observations endpoint](/api-reference#tag/observationsv2/GET/api/public/v2/observations) for cursor-based pagination and field selection.",
              "type": "text/plain"
            },
            "url": {
